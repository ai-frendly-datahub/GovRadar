# Radar-Template 환경 변수 설정 예시
# 이 파일을 .env로 복사하고 실제 값을 입력하세요.
# cp .env.example .env

# ====================================
# 데이터베이스 설정 (선택)
# ====================================
# DuckDB 파일 경로 (기본값: data/radar.duckdb)
# DB_PATH=data/radar.duckdb

# ====================================
# 리포트 설정 (선택)
# ====================================
# 리포트 출력 디렉토리 (기본값: docs/reports)
# REPORT_DIR=docs/reports

# ====================================
# 로깅 설정 (선택)
# ====================================
# 로그 레벨: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO
# LOG_FILE=logs/radar.log

# ====================================
# 알림 설정 (선택)
# ====================================
# 값은 적지 않습니다. 필요한 환경 변수 이름만 적습니다.
# NOTIFICATION_WEBHOOK_URL
# NOTIFICATION_EMAIL
# SMTP_HOST
# SMTP_PORT
# SMTP_USER
# SMTP_PASSWORD
# SMTP_FROM
# DATA_GO_KR_API_KEY  (공공데이터포털 https://www.data.go.kr 활용신청. 보조금24/정부24 OpenAPI)

# ====================================
# 고급 설정 (선택)
# ====================================
# 수집 간격 (시간 단위)
# COLLECTION_INTERVAL=24

# Rate Limit 설정
# REQUESTS_PER_MINUTE=60

# 타임아웃 (초)
# REQUEST_TIMEOUT=30

# 재시도 횟수
# MAX_RETRIES=3
